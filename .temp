.taxonomy-card {
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    transform: translateZ(0);
    backface-visibility: hidden;
    perspective: 1000px;
    will-change: transform;
}

.taxonomy-card::before,
.taxonomy-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 2px solid transparent;
    border-radius: inherit;
    animation: borderAnimation 8s linear infinite;
}

.taxonomy-card::before {
    border-color: rgba(16, 185, 129, 0.15);
    animation-delay: -4s;
}

.taxonomy-card::after {
    border-color: rgba(16, 185, 129, 0.3);
}

.taxonomy-card:hover::before,
.taxonomy-card:hover::after {
    animation-duration: 4s;
}

.taxonomy-item {
    position: relative;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid transparent;
    overflow: hidden;
}

.taxonomy-item:hover {
    transform: translateX(8px);
    border-color: rgba(16, 185, 129, 0.2);
    background: none;
}

.taxonomy-item img {
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.taxonomy-item:hover img {
    transform: scale(1.1);
}

@media (max-width: 768px) {
    .taxonomy-card {
        padding: 1rem;
    }

    .taxonomy-item {
        padding: 0.75rem;
    }
}

/* Update the taxonomy explorer container styles */
.taxonomy-explorer-container {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden !important;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
    max-width: 100vw;
    overscroll-behavior: none;
    -webkit-overflow-scrolling: none;
}

/* Ensure proper touch target sizes for mobile */
.taxonomy-controls button,
.search-bar button {
    min-height: 44px;
    min-width: 44px;
}

/* Improve pinch-zoom behavior */
.taxonomy-explorer-container svg {
    touch-action: none;
    -ms-touch-action: none;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
}


.bento-card {
    position: relative;
    overflow: hidden;
    transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
    backface-visibility: hidden;
    transform: translateZ(0);
    -webkit-font-smoothing: subpixel-antialiased;
    perspective: 1000px;
}

.bento-card img {
    transition: all 0.7s cubic-bezier(0.22, 1, 0.36, 1);
}

.bento-card:hover img {
    transform: scale(1.05);
    transition-duration: 0.5s;
}

.bento-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, transparent, rgba(16, 185, 129, 0.1), transparent);
    transform: translateX(-100%);
    transition: transform 0.8s ease;
}

.bento-card:hover::after {
    transform: translateX(100%);
}

.bento-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -15px rgba(16, 185, 129, 0.1);
}

@media (min-width: 768px) {
    .bento-card {
        height: 100%;
    }
}

.scan-pulse {
    animation: scanPulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@keyframes scanPulse {

    0%,
    100% {
        opacity: 1;
    }

    50% {
        opacity: 0.5;
    }
}

/* Enhance the story mode navigation */
.story-navigation {
    position: relative;
    overflow: hidden;
}

.story-navigation::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(to right, #0d9488, #0891b2);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
}

.story-navigation:hover::after {
    transform: scaleX(1);
}



/* Add these styles to the end of the file */
.parallax-section {
    position: relative;
    overflow: hidden;
}

.parallax-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
}

.parallax-content {
    position: relative;
    z-index: 10;
}


.float-element {
    animation: floatAnimation 8s ease-in-out infinite;
}

.float-element-slow {
    animation: floatAnimation 12s ease-in-out infinite;
}

.float-element-fast {
    animation: floatAnimation 6s ease-in-out infinite;
}